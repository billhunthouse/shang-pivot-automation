[Unit]
Description=SkyWalking Alarm Webhook
Documentation=file:///opt/skywalking/alarm-webhook.py
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
Environment=ALARM_HOST=172.17.0.1
Environment=ALARM_PORT=18080
Environment=ALARM_LOG=/var/log/skywalking-alarm/alarms.jsonl
EnvironmentFile=-/etc/skywalking-webhook.env
ExecStart=/usr/bin/python3 /opt/skywalking/alarm-webhook.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/skywalking-alarm

[Install]
WantedBy=multi-user.target
