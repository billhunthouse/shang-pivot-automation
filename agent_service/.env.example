# Phase 0 Agent 服务配置
# 默认使用规则模型，便于本地无 API Key 验证编排、工具调用和 trace。
# 配置 OpenAI-compatible 网关后，LlmGateway 会自动切换。

# DeepSeek（模型名以 /v1/models 返回为准）
# AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
# AGENT_LLM_MODEL=deepseek-flash
# AGENT_LLM_API_KEY_FILE=/Users/imac/.zcode/secrets/deepseek-api-key
# AGENT_LLM_MAX_TOKENS=512

# OpenAI-compatible 通用示例：
# AGENT_LLM_BASE_URL=https://api.example.com/v1
# AGENT_LLM_API_KEY_FILE=/path/to/key-file
# AGENT_LLM_MODEL=qwen-plus

# 本地电商后端
COMMERCE_BASE_URL=http://127.0.0.1:8086/api

# trace：jsonl（默认，内存+文件）或 postgres（重启后仍可查）
AGENT_TRACE_BACKEND=jsonl
AGENT_TRACE_DIR=artifacts

# pgvector RAG（本地 shang-postgres；未开启时走关键词检索）
AGENT_RAG_ENABLED=0
# 连接串含密码，不要提交真实值
AGENT_PG_DSN=postgresql://<user>:<password>@127.0.0.1:5432/shang
AGENT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AGENT_EMBEDDING_DIM=512
AGENT_RAG_AUTO_INGEST=1
